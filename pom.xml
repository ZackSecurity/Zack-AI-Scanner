<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.zackai</groupId>
    <artifactId>zack-ai-scanner</artifactId>
    <version>3.0</version>
    <packaging>jar</packaging>

    <name>Zack-AI-Scanner</name>
    <description>AI-powered automated vulnerability scanner for Burp Suite</description>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>GNU General Public License v3.0 or later</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
            <distribution>repo</distribution>
            <comments>SPDX-License-Identifier: GPL-3.0-or-later</comments>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>net.portswigger.burp.extender</groupId>
            <artifactId>burp-extender-api</artifactId>
            <version>2.3</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>Zack-AI-Scanner-v${project.version}</finalName>
        <!-- 许可证正文随 JAR 一起分发：别人只下 JAR（不发源码）时也必须能拿到 GPL 全文，
             以及被打包进来的 Apache-2.0 组件的许可与署名（Apache-2.0 §4(a)/(d)）。
             所以是从仓库根目录取文件、放进包内 META-INF，而不是在 src/main/resources 里留副本。 -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                    <include>THIRD-PARTY-NOTICES.md</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.zackai.AISentryExtender</mainClass>
                                    <!-- 让 `unzip -p xxx.jar META-INF/MANIFEST.MF` 就能看出这是谁、什么协议，
                                         不必先解开 JAR 找 META-INF/LICENSE -->
                                    <manifestEntries>
                                        <Implementation-Title>Zack-AI-Scanner</Implementation-Title>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                        <Implementation-Vendor>Zack AI Scanner</Implementation-Vendor>
                                        <License-Name>GPL-3.0-or-later</License-Name>
                                        <License-URL>https://www.gnu.org/licenses/gpl-3.0.txt</License-URL>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/DEPENDENCIES</exclude>
                                        <!-- 这里**不能**排除 META-INF/LICENSE / NOTICE：本项目自己的
                                             GPL 全文与 THIRD-PARTY-NOTICES 就是通过 resources 进包内的，
                                             `*:*` 过滤器对本工程产物同样生效，排掉就把自己的许可也排掉了。
                                             几个被打包的依赖（gson/okhttp/okio/kotlin-stdlib）目前都不带
                                             LICENSE/NOTICE 条目，因此不存在同名冲突。 -->
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
